{
  "name": "vpn-deck-awg",
  "version": "3.0.0-beta.5",
  "description": "Universal WireGuard and AmneziaWG manager for Decky Loader",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest test_protocol.py test_unit.py test_plugin_smoke.py",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Einharr/vpn-deck-awg.git"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "vpn",
    "wireguard",
    "amneziawg",
    "awg3"
  ],
  "author": "Einharr; based on vpn-deck by MrWaip",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Einharr/vpn-deck-awg/issues"
  },
  "homepage": "https://github.com/Einharr/vpn-deck-awg#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "release-it": "^19.0.0",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}